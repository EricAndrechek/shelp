#!/bin/sh
# Fake agent CLI for internal/provider/agentcli_test.go.
#
# Behavior is entirely controlled by env vars so the same script body works
# for both claude/copilot fakes (see the sibling file, a byte-identical copy
# of this one). Historically this same script also stood in for gemini/
# codex/agy fakes (hence the now-unused "-o <path>" / codex-banner support
# below), before those providers were dropped for not being reducible to a
# plain completion (see agentcli.go's PURITY note); left in place since it's
# harmless and this stays one script for both remaining fakes:
#
#   SHELP_FAKE_VERSION / SHELP_FAKE_VERSION_EXIT  - reply to a "--version" arg
#   SHELP_FAKE_HELP                               - reply to a "--help" arg
#   SHELP_FAKE_AUTH_JSON / SHELP_FAKE_AUTH_EXIT    - reply to "auth status"
#   SHELP_FAKE_LOGIN_STATUS / SHELP_FAKE_LOGIN_EXIT - reply to "login status"
#   SHELP_FAKE_RECORD    - path to dump cwd/stdin-byte-count/-C-dir-check/
#                           MAX_THINKING_TOKENS-env/argv to, for the main
#                           (non-identity) call. Args are written
#                           NUL-separated after an "ARGS:\n" marker since
#                           they may contain literal newlines (system+prompt
#                           is joined with "\n\n").
#   SHELP_FAKE_SLEEP     - seconds to sleep (via exec, so this process IS the
#                           sleep, no orphaned child) before doing anything
#                           else, to simulate a hung/interactive CLI
#   SHELP_FAKE_STDOUT    - stdout text for the main call (or, when argv has
#                           a "-o <path>" pair, the content written to that
#                           file instead -- unused by claude/copilot, kept
#                           for the shared script body)
#   SHELP_FAKE_STDOUT_NOISE - extra stdout text always printed to stdout,
#                           even when "-o" redirects the "real" reply to a
#                           file (unused by claude/copilot; see above)
#   SHELP_FAKE_STDERR    - stderr text for the main call
#   SHELP_FAKE_EXIT      - exit code for the main call (default 0)
#   SHELP_FAKE_ECHO_CWD  - when set, print this process's cwd (`pwd -P`) as
#                           the entire stdout reply and exit immediately,
#                           ignoring SHELP_FAKE_STDOUT/RECORD/etc. Used to
#                           observe the subprocess's own working directory
#                           from concurrent callers without any of them
#                           writing to shared state (a record file, an env
#                           var) that a race detector would flag.

# SHELP_FAKE_TRACE: append one line per invocation (any mode): pgid, whether
# the iTerm2 session vars are set, argv. SHELP_FAKE_GRANDCHILD: path; a
# background `sleep 60` is started in the same group and its pid written there.
if [ -n "$SHELP_FAKE_TRACE" ]; then
  echo "PGID:$(ps -o pgid= -p $$ | tr -d ' ') ITERM:${ITERM_SESSION_ID-<unset>} TERMSESS:${TERM_SESSION_ID-<unset>} LCT:${LC_TERMINAL-<unset>} ARGS:$*" >>"$SHELP_FAKE_TRACE"
fi
if [ -n "$SHELP_FAKE_GRANDCHILD" ]; then
  sleep 60 >/dev/null 2>&1 &
  echo $! >"$SHELP_FAKE_GRANDCHILD"
fi

has_version=0
has_help=0
for a in "$@"; do
  case "$a" in
  --version) has_version=1 ;;
  --help) has_help=1 ;;
  esac
done

if [ "$has_version" = 1 ]; then
  printf '%s\n' "${SHELP_FAKE_VERSION:-fake 0.0.0}"
  exit "${SHELP_FAKE_VERSION_EXIT:-0}"
fi
if [ "$has_help" = 1 ]; then
  printf '%s\n' "${SHELP_FAKE_HELP:-Fake CLI help}"
  exit 0
fi
if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
  # A brace-containing default inside ${VAR:-...} confuses some shells'
  # expansion-matching (the first unescaped "}" closes the expansion early,
  # leaking a stray "}" into the output), so default via a plain if instead.
  auth_json="$SHELP_FAKE_AUTH_JSON"
  if [ -z "$auth_json" ]; then auth_json='{"loggedIn":true}'; fi
  printf '%s' "$auth_json"
  exit "${SHELP_FAKE_AUTH_EXIT:-0}"
fi
if [ "$1" = "login" ] && [ "$2" = "status" ]; then
  printf '%s\n' "${SHELP_FAKE_LOGIN_STATUS:-Logged in using Fake}"
  exit "${SHELP_FAKE_LOGIN_EXIT:-0}"
fi

if [ -n "$SHELP_FAKE_ECHO_CWD" ]; then
  printf '%s' "$(pwd -P)"
  exit "${SHELP_FAKE_EXIT:-0}"
fi

if [ -n "$SHELP_FAKE_SLEEP" ]; then
  # exec replaces this process with sleep (same PID): a context-cancel kill
  # then hits the sleeping process directly, with no orphaned child left
  # holding the stdout/stderr pipes open.
  exec sleep "$SHELP_FAKE_SLEEP"
fi

if [ -n "$SHELP_FAKE_RECORD" ]; then
  stdinbytes=$(wc -c </dev/stdin 2>/dev/null | tr -d ' ')
  cdir=""
  prev=""
  for a in "$@"; do
    if [ "$prev" = "-C" ]; then
      cdir="$a"
    fi
    prev="$a"
  done
  cdirexists="n/a"
  if [ -n "$cdir" ]; then
    if [ -d "$cdir" ]; then cdirexists="yes"; else cdirexists="no"; fi
  fi
  envmaxthinking="$MAX_THINKING_TOKENS"
  if [ -z "$envmaxthinking" ]; then envmaxthinking='<unset>'; fi
  {
    echo "CWD:$(pwd -P)"
    echo "STDINBYTES:${stdinbytes:-0}"
    echo "CDIREXISTS:$cdirexists"
    echo "ENVMAXTHINKING:$envmaxthinking"
    printf 'ARGS:\n'
    for a in "$@"; do
      printf '%s\0' "$a"
    done
  } >"$SHELP_FAKE_RECORD"
fi

outfile=""
prev=""
for a in "$@"; do
  if [ "$prev" = "-o" ]; then
    outfile="$a"
  fi
  prev="$a"
done

if [ -n "$outfile" ]; then
  printf '%s' "$SHELP_FAKE_STDOUT" >"$outfile"
  if [ -n "$SHELP_FAKE_STDOUT_NOISE" ]; then
    printf '%s' "$SHELP_FAKE_STDOUT_NOISE"
  fi
else
  printf '%s' "$SHELP_FAKE_STDOUT"
fi

if [ -n "$SHELP_FAKE_STDERR" ]; then
  printf '%s' "$SHELP_FAKE_STDERR" >&2
fi

exit "${SHELP_FAKE_EXIT:-0}"
