#compdef shelp
# shelp tab completion for zsh (generated by `shelp completion zsh`).
# Tasks are free text, so nothing completes after a task's first word.
# Commands, their flags and subcommands come from the binary at Tab time
# (`shelp __complete commands|flags|subcommands`): a shell keeps the script
# it loaded across an upgrade, so a list in here would go stale. Only what
# is about the kind of a value (shells, providers, templates, context
# fields) is known here.

# _shelp_command_lines: reply = "name<TAB>description" per command. The list
# rendered here is the fallback for a shelp too old to answer.
_shelp_command_lines() {
  local out
  out=$(command shelp __complete commands 2>/dev/null)
  [[ -n $out ]] || out=$(printf '%s\t%s\n'⟦range .Commands⟧ ⟦sq .Name⟧ ⟦sq .Desc⟧⟦end⟧)
  reply=(${(f)out})
}

_shelp_values() {
  local -a vals
  case $1 in
    providers)
      vals=(${(f)"$(command shelp __complete providers 2>/dev/null)"})
      compset -P '*,'; compadd -S '' -a vals ;;
    templates)
      vals=(${(f)"$(command shelp __complete templates 2>/dev/null)"})
      compadd -a vals ;;
    presets)
      vals=(${(f)"$(command shelp __complete presets 2>/dev/null)"})
      compadd -a vals ;;
    routes)
      vals=(${(f)"$(command shelp __complete routes 2>/dev/null)"})
      compadd -a vals ;;
    context) compset -P '*,'; compadd -S '' -- ⟦.Context⟧ ;;
    shells) compadd -- ⟦.Shells⟧ ;;
  esac
}

_shelp() {
  emulate -L zsh
  local cur=${words[CURRENT]} prev=${words[CURRENT-1]}
  local cmd='' arg1='' w
  local -i npos=0 skip=0 i
  for (( i = 2; i < CURRENT; i++ )); do
    w=${words[i]}
    if (( skip )); then skip=0; continue; fi
    case $w in
      ⟦.ValueFlags⟧) skip=1 ;;
      -e) [[ -z $cmd ]] && cmd=explain ;;
      -*) ;;
      *) if [[ -z $cmd ]]; then cmd=$w
         else (( npos++ == 0 )) && arg1=$w; fi ;;
    esac
  done

  if (( CURRENT > 2 )); then
    case $prev in
      -p|--provider) _shelp_values providers; return ;;
      --template) _shelp_values templates; return ;;
      --context) _shelp_values context; return ;;
      --shell) _shelp_values shells; return ;;
      --preset) _shelp_values presets; return ;;
      --bind|--base-url|--key-env|--model|--label|-n|-s|--search) return ;;
    esac
  fi

  local -a flags subs reply
  case $cmd in
    '')
      if [[ $cur == -* ]]; then
        flags=(${(f)"$(command shelp __complete flags 2>/dev/null)"})
      else
        _shelp_command_lines
        local -a names=(${reply%%$'\t'*}) descs=(${reply/$'\t'/ -- })
        compadd -l -d descs -a names
        return
      fi ;;
    init|completion)
      if (( npos == 0 )) && [[ $cur != -* ]]; then compadd -- ⟦.Shells⟧; return; fi ;;
    help)
      if (( npos == 0 )) && [[ $cur != -* ]]; then
        _shelp_command_lines
        compadd -- suggest ${reply%%$'\t'*}
        return
      fi ;;
    config)
      if [[ $arg1 == chain && $cur != -* ]]; then _shelp_values providers; return; fi
      if [[ $arg1 == remove && $cur != -* ]] && (( npos == 1 )); then _shelp_values routes; return; fi ;;
  esac
  if [[ -n $cmd ]]; then
    if (( npos == 0 )) && [[ $cur != -* ]]; then
      subs=(${(f)"$(command shelp __complete subcommands $cmd 2>/dev/null)"})
      if (( $#subs )); then compadd -- $subs; return; fi
    elif (( npos == 1 )) && [[ $cur != -* ]]; then
      subs=(${(f)"$(command shelp __complete subcommands $cmd $arg1 2>/dev/null)"})
      if (( $#subs )); then compadd -- $subs; return; fi
    fi
    [[ $cur == -* ]] || return 0
    # flags are the task's own once it starts: `shelp explain ls -l`
    [[ $cmd == (explain|suggest) ]] && (( npos > 0 )) && return 0
    # no flags at all: a task (free text), not a command
    flags=(${(f)"$(command shelp __complete flags $cmd $arg1 2>/dev/null)"})
  fi
  (( $#flags )) && [[ $cur == -* ]] && compadd -- $flags
  return 0
}

# Loaded as the autoloaded completion file (fpath, e.g. Homebrew's), run it;
# loaded any other way (eval, source, `shelp init zsh`), register it. Never
# calls compinit: when compdef is not there yet (this runs before compinit),
# register once at the first prompt, when it is.
if [[ ${funcstack[1]-} == _shelp ]]; then
  _shelp "$@"
elif (( ${+functions[compdef]} )); then
  compdef _shelp shelp
else
  _shelp_register_completion() {
    (( ${+functions[compdef]} )) || return 0
    compdef _shelp shelp
    precmd_functions=(${precmd_functions:#_shelp_register_completion})
    unfunction _shelp_register_completion
  }
  precmd_functions+=(_shelp_register_completion)
fi
