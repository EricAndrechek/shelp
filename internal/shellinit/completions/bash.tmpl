# shelp tab completion for bash (generated by `shelp completion bash`).
# Tasks are free text, so nothing completes after a task's first word.
# Commands, their flags and subcommands come from the binary at Tab time
# (`shelp __complete commands|flags|subcommands`): a shell keeps the script
# it loaded across an upgrade, so a list in here would go stale. Only what
# is about the kind of a value (shells, providers, templates, context
# fields) is known here.

# _shelp_command_lines: "name<TAB>description" per command. The list
# rendered here is the fallback for a shelp too old to answer.
_shelp_command_lines() {
  local out
  out=$(command shelp __complete commands 2>/dev/null)
  [[ -n $out ]] || out=$(printf '%s\t%s\n'⟦range .Commands⟧ ⟦sq .Name⟧ ⟦sq .Desc⟧⟦end⟧)
  printf '%s\n' "$out"
}

# _shelp_command_names: the command names, space-separated.
_shelp_command_names() {
  local l
  while IFS= read -r l; do printf '%s ' "${l%%$'\t'*}"; done < <(_shelp_command_lines)
}

_shelp_values() {   # _shelp_values KIND CUR
  local vals='' v prefix='' cands=''
  case $1 in
    providers) vals=$(command shelp __complete providers 2>/dev/null) ;;
    templates) vals=$(command shelp __complete templates 2>/dev/null) ;;
    context) vals='⟦.Context⟧' ;;
    shells) vals='⟦.Shells⟧' ;;
  esac
  case $1 in providers|context)
    prefix=${2%"${2##*,}"}
    compopt -o nospace 2>/dev/null ;;
  esac
  for v in $vals; do cands+="$prefix$v "; done
  _shelp_reply "$cands" "$2"
}

# _shelp_reply WORDS CUR: set COMPREPLY to the WORDS starting with CUR. A
# provider ID has a colon, which bash splits words at, so the part up to
# the last colon is left off each reply.
_shelp_reply() {
  local trim='' reply
  # compgen -W splits WORDS on IFS (blanks); the replies come back one per line
  reply=$(compgen -W "$1" -- "$2")
  local IFS=$'\n'
  COMPREPLY=($reply)
  if [[ $COMP_WORDBREAKS == *:* && $2 == *:* ]]; then
    trim=${2%"${2##*:}"}
    COMPREPLY=("${COMPREPLY[@]#"$trim"}")
  fi
}

_shelp() {
  local line=${COMP_LINE:0:COMP_POINT} cur prev='' cmd='' arg1='' w i n
  local -a words
  read -ra words <<<"$line"
  [[ -z $line || $line == *[[:space:]] ]] && words+=('')
  n=${#words[@]}
  cur=${words[n-1]}
  (( n > 1 )) && prev=${words[n-2]}
  local npos=0 skip=0
  for (( i = 1; i < n - 1; i++ )); do
    w=${words[i]}
    if (( skip )); then skip=0; continue; fi
    case $w in
      ⟦.ValueFlags⟧) skip=1 ;;
      -e) [[ -z $cmd ]] && cmd=explain ;;
      -*) ;;
      *) if [[ -z $cmd ]]; then cmd=$w
         else (( npos++ == 0 )) && arg1=$w; fi ;;
    esac
  done
  COMPREPLY=()
  if (( n > 2 )); then
    case $prev in
      -p|--provider) _shelp_values providers "$cur"; return ;;
      --template) _shelp_values templates "$cur"; return ;;
      --context) _shelp_values context "$cur"; return ;;
      --shell) _shelp_values shells "$cur"; return ;;
      --bind) return ;;
    esac
  fi

  local flags=''
  case $cmd in
    '')
      if [[ $cur == -* ]]; then flags=$(command shelp __complete flags 2>/dev/null)
      else _shelp_reply "$(_shelp_command_names)" "$cur"; return; fi ;;
    init|completion)
      if (( npos == 0 )) && [[ $cur != -* ]]; then _shelp_reply '⟦.Shells⟧' "$cur"; return; fi ;;
    help)
      if (( npos == 0 )) && [[ $cur != -* ]]; then _shelp_reply "suggest $(_shelp_command_names)" "$cur"; return; fi ;;
    config)
      if [[ $arg1 == chain && $cur != -* ]]; then _shelp_values providers "$cur"; return; fi ;;
  esac
  if [[ -n $cmd ]]; then
    if (( npos == 0 )) && [[ $cur != -* ]]; then
      flags=$(command shelp __complete subcommands "$cmd" 2>/dev/null)
      if [[ -n $flags ]]; then _shelp_reply "$flags" "$cur"; return; fi
    fi
    [[ $cur == -* ]] || return 0
    # flags are the task's own once it starts: `shelp explain ls -l`
    if [[ $cmd == explain || $cmd == suggest ]] && (( npos > 0 )); then return 0; fi
    # no flags at all: a task (free text), not a command
    flags=$(command shelp __complete flags "$cmd" ${arg1:+"$arg1"} 2>/dev/null)
  fi
  [[ $cur == -* ]] && _shelp_reply "$flags" "$cur"
  return 0
}

# No `-o default`: a task is never completed as a filename.
complete -F _shelp shelp
