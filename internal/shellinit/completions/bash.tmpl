# shelp tab completion for bash (generated by `shelp completion bash`).
# Tasks are free text, so nothing completes after a task's first word.
_shelp_values() {   # _shelp_values KIND CUR
  local vals='' v prefix='' cands=''
  case $1 in
    providers) vals=$(command shelp __complete providers 2>/dev/null) ;;
    templates) vals=$(command shelp __complete templates 2>/dev/null) ;;
    context) vals='⟦.Context⟧' ;;
    shells) vals='⟦.Shells⟧' ;;
  esac
  case $1 in providers|context)
    prefix=${2%"${2##*,}"}
    compopt -o nospace 2>/dev/null ;;
  esac
  for v in $vals; do cands+="$prefix$v "; done
  _shelp_reply "$cands" "$2"
}

# _shelp_reply WORDS CUR: set COMPREPLY to the WORDS starting with CUR. A
# provider ID has a colon, which bash splits words at, so the part up to
# the last colon is left off each reply.
_shelp_reply() {
  local trim='' reply
  # compgen -W splits WORDS on IFS (blanks); the replies come back one per line
  reply=$(compgen -W "$1" -- "$2")
  local IFS=$'\n'
  COMPREPLY=($reply)
  if [[ $COMP_WORDBREAKS == *:* && $2 == *:* ]]; then
    trim=${2%"${2##*:}"}
    COMPREPLY=("${COMPREPLY[@]#"$trim"}")
  fi
}

_shelp() {
  local line=${COMP_LINE:0:COMP_POINT} cur prev='' cmd='' arg1='' w i n
  local -a words
  read -ra words <<<"$line"
  [[ -z $line || $line == *[[:space:]] ]] && words+=('')
  n=${#words[@]}
  cur=${words[n-1]}
  (( n > 1 )) && prev=${words[n-2]}
  local npos=0 skip=0
  for (( i = 1; i < n - 1; i++ )); do
    w=${words[i]}
    if (( skip )); then skip=0; continue; fi
    case $w in
      ⟦.ValueFlags⟧) skip=1 ;;
      -e) [[ -z $cmd ]] && cmd=explain ;;
      -*) ;;
      *) if [[ -z $cmd ]]; then cmd=$w
         else (( npos++ == 0 )) && arg1=$w; fi ;;
    esac
  done
  COMPREPLY=()
  if (( n > 2 )); then
    case $prev in
      -p|--provider) _shelp_values providers "$cur"; return ;;
      --template) _shelp_values templates "$cur"; return ;;
      --context) _shelp_values context "$cur"; return ;;
      --shell) _shelp_values shells "$cur"; return ;;
      --bind) return ;;
    esac
  fi

  local flags=''
  case $cmd in
    '')
      if [[ $cur == -* ]]; then flags='⟦.Top⟧'
      else _shelp_reply '⟦.Names⟧' "$cur"; return; fi ;;
    explain|suggest) (( npos == 0 )) && flags='⟦.Gen⟧' ;;
    providers) flags='⟦.Providers⟧' ;;
    setup)
      if (( npos == 0 )) && [[ $cur != -* ]]; then _shelp_reply 'shell shortcuts' "$cur"; return; fi
      if [[ $arg1 == shell ]]; then flags='⟦.SetupShell⟧'; else flags='⟦.Help⟧'; fi ;;
    init|completion)
      if (( npos == 0 )) && [[ $cur != -* ]]; then _shelp_reply '⟦.Shells⟧' "$cur"; return; fi
      if [[ $cmd == init ]]; then flags='⟦.Init⟧'; else flags='⟦.Help⟧'; fi ;;
    help)
      if (( npos == 0 )) && [[ $cur != -* ]]; then _shelp_reply '⟦.Topics⟧' "$cur"; return; fi ;;
    config)
      if (( npos == 0 )) && [[ $cur != -* ]]; then _shelp_reply 'chain edit' "$cur"; return; fi
      if [[ $arg1 == chain && $cur != -* ]]; then _shelp_values providers "$cur"; return; fi
      flags='⟦.Help⟧' ;;
    *) return ;;   # a task: free text
  esac
  [[ $cur == -* ]] && _shelp_reply "$flags" "$cur"
  return 0
}

# No `-o default`: a task is never completed as a filename.
complete -F _shelp shelp
