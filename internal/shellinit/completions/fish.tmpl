# shelp tab completion for fish (generated by `shelp completion fish`).
# Tasks are free text, so nothing completes after a task's first word.
function __shelp_values
    switch $argv[1]
        case providers
            for v in (command shelp __complete providers 2>/dev/null)
                echo $argv[2]$v
            end
        case templates
            command shelp __complete templates 2>/dev/null
        case context
            for v in ⟦.Context⟧
                echo $argv[2]$v
            end
        case shells
            printf '%s\n' ⟦.Shells⟧
    end
end

function __shelp_complete
    set -l toks (commandline -opc)
    set -e toks[1]
    set -l cur (commandline -ct)
    set -l prev ''
    set -q toks[1]; and set prev $toks[-1]
    set -l cmd ''
    set -l arg1 ''
    set -l npos 0
    set -l skip 0
    for w in $toks
        if test $skip = 1
            set skip 0
            continue
        end
        switch $w
            case ⟦.ValueFlagWords⟧
                set skip 1
            case -e
                test -z "$cmd"; and set cmd explain
            case '-*'
            case '*'
                if test -z "$cmd"
                    set cmd $w
                else
                    test $npos = 0; and set arg1 $w
                    set npos (math $npos + 1)
                end
        end
    end

    set -l prefix (string replace -r '[^,]*$' '' -- $cur)
    switch $prev
        case -p --provider
            __shelp_values providers "$prefix"; return
        case --template
            __shelp_values templates ''; return
        case --context
            __shelp_values context "$prefix"; return
        case --shell
            __shelp_values shells ''; return
        case --bind
            return
    end

    set -l flags
    switch $cmd
        case ''
            if string match -q -- '-*' $cur
                set flags ⟦.Top⟧
            else
⟦- range .Commands⟧
                printf '%s\t%s\n' ⟦.Name⟧ '⟦.Desc⟧'
⟦- end⟧
                return
            end
        case explain suggest
            test $npos = 0; and set flags ⟦.Gen⟧
        case providers
            set flags ⟦.Providers⟧
        case setup
            if test $npos = 0; and not string match -q -- '-*' $cur
                printf '%s\n' shell shortcuts; return
            end
            if test "$arg1" = shell
                set flags ⟦.SetupShell⟧
            else
                set flags ⟦.Help⟧
            end
        case init completion
            if test $npos = 0; and not string match -q -- '-*' $cur
                printf '%s\n' ⟦.Shells⟧; return
            end
            if test "$cmd" = init
                set flags ⟦.Init⟧
            else
                set flags ⟦.Help⟧
            end
        case help
            if test $npos = 0; and not string match -q -- '-*' $cur
                printf '%s\n' ⟦.Topics⟧; return
            end
        case config
            if test $npos = 0; and not string match -q -- '-*' $cur
                printf '%s\n' chain edit; return
            end
            if test "$arg1" = chain; and not string match -q -- '-*' $cur
                __shelp_values providers "$prefix"; return
            end
            set flags ⟦.Help⟧
        case '*'
            return
    end
    string match -q -- '-*' $cur; and printf '%s\n' $flags
end

complete -e -c shelp
complete -c shelp -f -a '(__shelp_complete)'
