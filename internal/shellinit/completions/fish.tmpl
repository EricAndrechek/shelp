# shelp tab completion for fish (generated by `shelp completion fish`).
# Tasks are free text, so nothing completes after a task's first word.
# Commands, their flags and subcommands come from the binary at Tab time
# (`shelp __complete commands|flags|subcommands`): a shell keeps the script
# it loaded across an upgrade, so a list in here would go stale. Only what
# is about the kind of a value (shells, providers, templates, context
# fields) is known here.

# __shelp_commands: "name<TAB>description" per command, fish's own format.
# The list rendered here is the fallback for a shelp too old to answer.
function __shelp_commands
    set -l out (command shelp __complete commands 2>/dev/null)
    if test (count $out) -eq 0
        printf '%s\t%s\n'⟦range .Commands⟧ ⟦fq .Name⟧ ⟦fq .Desc⟧⟦end⟧
    else
        printf '%s\n' $out
    end
end

function __shelp_values
    switch $argv[1]
        case providers
            for v in (command shelp __complete providers 2>/dev/null)
                echo $argv[2]$v
            end
        case templates
            command shelp __complete templates 2>/dev/null
        case presets
            command shelp __complete presets 2>/dev/null
        case routes
            command shelp __complete routes 2>/dev/null
        case context
            for v in ⟦.Context⟧
                echo $argv[2]$v
            end
        case shells
            printf '%s\n' ⟦.Shells⟧
    end
end

function __shelp_complete
    set -l toks (commandline -opc)
    set -e toks[1]
    set -l cur (commandline -ct)
    set -l prev ''
    set -q toks[1]; and set prev $toks[-1]
    set -l cmd ''
    set -l arg1 ''
    set -l npos 0
    set -l skip 0
    for w in $toks
        if test $skip = 1
            set skip 0
            continue
        end
        switch $w
            case ⟦.ValueFlagWords⟧
                set skip 1
            case -e
                test -z "$cmd"; and set cmd explain
            case '-*'
            case '*'
                if test -z "$cmd"
                    set cmd $w
                else
                    test $npos = 0; and set arg1 $w
                    set npos (math $npos + 1)
                end
        end
    end

    set -l prefix (string replace -r '[^,]*$' '' -- $cur)
    switch $prev
        case -p --provider
            __shelp_values providers "$prefix"; return
        case --template
            __shelp_values templates ''; return
        case --context
            __shelp_values context "$prefix"; return
        case --shell
            __shelp_values shells ''; return
        case --preset
            __shelp_values presets ''; return
        case --bind --base-url --key-env --model --label -n -s --search
            return
    end

    set -l isflag 0
    string match -q -- '-*' $cur; and set isflag 1
    switch $cmd
        case ''
            if test $isflag = 1
                command shelp __complete flags 2>/dev/null
            else
                __shelp_commands
            end
            return
        case init completion
            if test $npos = 0; and test $isflag = 0
                printf '%s\n' ⟦.Shells⟧; return
            end
        case help
            if test $npos = 0; and test $isflag = 0
                printf '%s\n' suggest; __shelp_commands | string replace -r '\t.*' ''; return
            end
        case config
            if test "$arg1" = chain; and test $isflag = 0
                __shelp_values providers "$prefix"; return
            end
            if test "$arg1" = remove; and test $npos = 1; and test $isflag = 0
                __shelp_values routes ''; return
            end
    end
    if test $npos = 0; and test $isflag = 0
        set -l subs (command shelp __complete subcommands $cmd 2>/dev/null)
        if test (count $subs) -gt 0
            printf '%s\n' $subs; return
        end
    else if test $npos = 1; and test $isflag = 0
        set -l subs (command shelp __complete subcommands $cmd $arg1 2>/dev/null)
        if test (count $subs) -gt 0
            printf '%s\n' $subs; return
        end
    end
    test $isflag = 1; or return
    # flags are the task's own once it starts: `shelp explain ls -l`
    contains -- $cmd explain suggest; and test $npos -gt 0; and return
    # no flags at all: a task (free text), not a command
    command shelp __complete flags $cmd $arg1 2>/dev/null
end

complete -e -c shelp
complete -c shelp -f -a '(__shelp_complete)'
