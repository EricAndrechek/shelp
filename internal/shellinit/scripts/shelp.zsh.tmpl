# shelp shell integration for zsh. Load with:  eval "$(shelp init zsh)"
# SHELP_HOOKS lists the shells whose integration is loaded, so
# `shelp setup shell` can tell the hook is already active.
typeset -gx SHELP_HOOKS="zsh${SHELP_HOOKS:+ $SHELP_HOOKS}"
# `shelp <task>` puts the suggested command on your next prompt line
# (print -rz: -r, or print would turn a `\n` in the command into a real
# newline), ready to edit or run; so does `shelp suggest <task>`. Commands
# (`shelp providers`, `shelp help config`, ...) pass straight through.
#
# The wrapper calls no other function of this hook: some environments keep
# only some functions (Claude Code's shell snapshot drops every one whose
# name starts with `_`, which made this fail with "command not found:
# _shelp_is_task"), so the command-or-task question is asked inline, the
# way _shelp_is_task below asks it. The binary decides (`shelp __kind`),
# not a list here: a shell keeps this hook until it restarts, so a list
# would miss commands added by an upgrade since and send `shelp <new
# command>` to the model. SHELP_PROVIDER names no provider so a shelp too
# old to know __kind fails at once instead of asking a model about
# "__kind ..."; any answer but "task" runs the arguments as typed.
shelp() {
  if [[ ${1-} == suggest ]]; then
    shift
  elif [[ -z ${1-} || $(SHELP_PROVIDER=__kind command shelp __kind "$@" 2>/dev/null) != task ]]; then
    SHELP_SHELL=zsh command shelp "$@"
    return
  fi
  local cmd
  cmd=$(SHELP_SHELL=zsh command shelp suggest "$@") || return
  [[ -n $cmd ]] && print -rz -- "$cmd"
}

# Don't glob the task: `shelp find all *.log files` should reach shelp as
# typed, not fail with "no matches found" (or expand to filenames) first.
# (Raw line mode below bypasses this path entirely for a bare `shelp
# <task>` at the prompt; noglob still matters for `shelp task` run from a
# script, a keybinding, or `zsh -c`.)
alias shelp='noglob shelp'

# In-progress status: a spinner drawn like zsh-autosuggestions' gray
# suggestion -- `  ⠋ shelp: thinking…` appended to the line via POSTDISPLAY
# and colored by two region_highlight entries, the frame cyan and the text
# gray (offsets are relative to BUFFER, so they start at $#BUFFER and span
# POSTDISPLAY; no `P` flag, which only matters when PREDISPLAY is
# highlighted). Every frame is one character, so the ranges stay valid while
# it spins. Afterwards the prior POSTDISPLAY is put back and only our two
# entries are removed, by range, so other plugins' highlights survive.
# NO_COLOR skips the color, not the animation. zsh/zselect sleeps between
# frames without spawning a process (`sleep` only if it's missing).
typeset -gi _shelp_zselect=0
zmodload zsh/zselect 2>/dev/null && _shelp_zselect=1

# _shelp_run_animated ARGS...: run `command shelp ARGS` in the background,
# animating the status until it exits. Sets the caller's _shelp_out to its
# stdout (trailing newlines stripped, as $(...) does) and _shelp_err to its
# stderr, and returns its exit status -- or 130 when Ctrl-C cancelled it,
# after making sure it is gone. Temp files are removed on every path.
_shelp_run_animated() {
  emulate -L zsh
  # nomonitor/nonotify: no job-control chatter ([1] 12345, "done") and no
  # new process group. That also makes the job ignore SIGINT -- the INT
  # trap below stops it instead (shelp itself re-enables SIGINT, so Ctrl-C
  # still reaches it the way it reaches a foreground command). nobgnice:
  # same priority as a foreground command.
  setopt localtraps nomonitor nonotify nobgnice noerrexit noerrreturn
  _shelp_out='' _shelp_err=''
  local text='shelp: thinking…' saved_post=$POSTDISPLAY tmpd pid sig t k
  local -i rc=0 intr=0 i=0 n=$#BUFFER
  local -a frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) hl
  # Hide the cursor while the frame spins: every `zle -R` draws the status
  # and then moves the cursor back to the end of the line, and terminals
  # paint that round trip as the cursor block jumping onto the spinner.
  local hide='' show=''
  if [[ ${TERM-} != dumb && -n ${TTY-} && -w ${TTY-} ]]; then
    hide=$'\e[?25l' show=$'\e[?25h'
  fi
  if [[ -z ${NO_COLOR-} ]]; then
    k='fg=6'
    [[ ${COLORTERM-} == (truecolor|24bit) ]] && k='fg=#00c4b4'
    hl=("$(( n + 2 )) $(( n + 3 )) $k" "$(( n + 3 )) $(( n + 4 + $#text )) fg=8")
  fi
  tmpd=$(command mktemp -d "${TMPDIR:-/tmp}/shelp.XXXXXX" 2>/dev/null)
  region_highlight+=("${hl[@]}")
  POSTDISPLAY="  ${frames[1]} $text"
  [[ -n $hide ]] && print -rn -- $hide >$TTY 2>/dev/null
  zle -R
  if [[ -z $tmpd || ! -d $tmpd ]]; then
    # nowhere to collect output: block, with the first frame standing still
    _shelp_out=$(command shelp "$@" 2>/dev/null)
    rc=$?
  else
    trap 'intr=1' INT
    command shelp "$@" >|$tmpd/out 2>|$tmpd/err &
    pid=$!
    while :; do
      if (( _shelp_zselect )); then zselect -t 8; else command sleep 0.08; fi
      (( intr )) && break
      kill -0 $pid 2>/dev/null || break
      (( i++ ))
      POSTDISPLAY="  ${frames[i % $#frames + 1]} $text"
      zle -R
    done
    (( intr )) || wait $pid
    rc=$?
    if (( intr )); then
      # Ctrl-C: give the line back at once, then make sure shelp is gone --
      # INT first (it cancels its own model call), then TERM, then KILL.
      POSTDISPLAY=$saved_post
      for k in "${hl[@]}"; do
        region_highlight=("${(@)region_highlight:#${k% *} *}")
      done
      hl=()
      zle -R
      [[ -n $show ]] && print -rn -- $show >$TTY 2>/dev/null
      for sig in INT TERM KILL; do
        kill -$sig $pid 2>/dev/null || break
        for t in 1 2 3 4 5; do
          kill -0 $pid 2>/dev/null || break 2
          if (( _shelp_zselect )); then zselect -t 5; else command sleep 0.05; fi
        done
      done
      wait $pid 2>/dev/null
      rc=130
    else
      [[ -r $tmpd/out ]] && _shelp_out=$(<$tmpd/out)
      [[ -r $tmpd/err ]] && _shelp_err=$(<$tmpd/err)
    fi
    command rm -rf -- "$tmpd" 2>/dev/null
  fi
  POSTDISPLAY=$saved_post
  for k in "${hl[@]}"; do
    # match by range, not full string: zsh rewrites the style of an entry
    # it can't render (e.g. fg=8 on an 8-color TERM becomes `none`)
    region_highlight=("${(@)region_highlight:#${k% *} *}")
  done
  [[ -n $show ]] && print -rn -- $show >$TTY 2>/dev/null
  return $rc
}

# _shelp_show_err TEXT: show what shelp printed on stderr under the line
# (`zle -M`: it stays until the next key and survives the redraw). Shelp's
# own messages already start with `shelp: `, so only a message that does
# not gets the prefix. TEXT has no trailing newline ($(...) and
# _shelp_run_animated strip it); several lines display as several lines.
_shelp_show_err() {
  local msg=$1
  [[ -n $msg ]] || return 0
  [[ $msg == shelp:* ]] || msg="shelp: $msg"
  zle -M "$msg"
}

# Widget: turn the text on the command line into a command in place.
{{if .Bind}}# Bound to '{{.Bind}}' below.{{else}}# Bind it yourself, e.g.:  bindkey '^G' shelp-widget{{end}}
shelp-widget() {
  [[ -z $BUFFER ]] && return
  local _shelp_out _shelp_err
  SHELP_SHELL=zsh _shelp_run_animated suggest -- "$BUFFER"
  if [[ -n $_shelp_out ]]; then
    BUFFER=$_shelp_out
    CURSOR=${#BUFFER}
  fi
  zle reset-prompt
  # A hint printed alongside a good answer (an outdated Shortcut, "already
  # a command"); failures stay silent here, as before. After the
  # reset-prompt: it redraws the line and wipes a message shown before it.
  [[ -n $_shelp_out ]] && _shelp_show_err "$_shelp_err"
}
zle -N shelp-widget
{{if .Bind}}
bindkey '{{.Bind}}' shelp-widget
{{end}}
{{if .LineMode}}
# Raw line mode: pressing Enter on a line whose first word is `shelp`
# sends the REST OF THE LINE to shelp byte-for-byte -- no shell parsing,
# so apostrophes, spaces, `$vars` and globs all reach the model exactly as
# typed. `shelp providers`, `shelp -p ... task`, and every other
# subcommand/flag form still runs normally. Opt out with `shelp init zsh
# --no-line-mode` or config `[shell] line_mode = false`.

# _shelp_is_task ARGS...: the question the wrapper above asks inline, for
# raw line mode: true when `shelp ARGS` is a task to suggest a command for,
# false when the binary runs it as one of its commands.
_shelp_is_task() {
  [[ $(SHELP_PROVIDER=__kind command shelp __kind "$@" 2>/dev/null) == task ]]
}

# _shelp_line_is_task REST: _shelp_is_task on the words of REST, the line
# after `shelp`, split on whitespace only (no quote removal, no expansion:
# a quoted or globbed word is never a command) and cut where the shell
# would end shelp's arguments, at the first operator or redirection --
# `shelp help config | less` asks about `help config`.
_shelp_line_is_task() {
  emulate -L zsh
  setopt extendedglob
  local IFS=$' \t\n' w
  local -a args
  for w in ${=1}; do
    [[ $w == [0-9]#[\<\>\|\&\;\(\)]* ]] && break
    args+=("$w")
  done
  _shelp_is_task "${args[@]}"
}

_shelp_raw_dispatch() {
  # $1: mode (suggest|explain); $2: original typed line (for history);
  # $3: raw payload, byte-for-byte.
  emulate -L zsh
  local kind=$1 orig=$2 body=$3 cmd rc shown _shelp_out _shelp_err
  if [[ $kind == explain ]]; then
    # `zle -I` moves below the typed line so the explanation prints like a
    # command's output; then one blank line. No `zle reset-prompt`
    # afterwards: zle doesn't know about the output, so reset-prompt would
    # move up to where it last drew the prompt -- one line for the edit
    # line plus one per extra prompt line -- and redraw over the blank line
    # and, with a two-line prompt (powerlevel10k), the explanation's last
    # line. `zle -I` already makes zle draw a fresh prompt below on return.
    zle -I
    command shelp explain --shell zsh -- "$body"
    rc=$?
    print
    if (( rc == 0 )); then
      print -s -- "$orig"
      BUFFER=''
      CURSOR=0
    else
      BUFFER=$orig
      CURSOR=${#BUFFER}
    fi
    return
  fi
  _shelp_run_animated suggest --shell zsh -- "$body"
  rc=$?
  cmd=$_shelp_out
  if (( rc == 0 )) && [[ -n $cmd ]]; then
    print -s -- "$orig"
    BUFFER=$cmd
    CURSOR=${#BUFFER}
    shown=$_shelp_err
  else
    BUFFER=$orig
    CURSOR=${#BUFFER}
    # 130: Ctrl-C cancelled it -- just hand the line back, no message
    (( rc != 130 )) && shown=$_shelp_err
  fi
  zle reset-prompt
  # stderr: shelp's error after a failure, a hint (stderr alongside a good
  # answer) after a success. After the reset-prompt, which redraws the line
  # and wipes a message shown before it.
  _shelp_show_err "$shown"
}

shelp-accept-line() {
  emulate -L zsh
  local raw=$BUFFER
  # Trim leading whitespace before checking the first word, so an
  # indented/pasted line is still recognized.
  local trimmed=${raw#"${raw%%[^[:space:]]*}"}
  case $trimmed in
    (shelp[[:space:]]*)
      local rest=${trimmed#shelp}
      rest=${rest#"${rest%%[^[:space:]]*}"}
      local word1=${rest%%[[:space:]]*}
      case $word1 in
        explain|-e)
          local tail=${rest#"$word1"}
          tail=${tail#"${tail%%[^[:space:]]*}"}
          if [[ -z $tail ]]; then
            zle accept-line
          else
            _shelp_raw_dispatch explain "$raw" "$tail"
          fi ;;
        ''|-*)
          # Nothing after `shelp`, or flags first (`shelp -p fm <task>`):
          # only the shell can parse those, so the line runs as typed.
          zle accept-line ;;
        *)
          # A command (`shelp providers`, `shelp help config`) runs as
          # typed; a task goes to shelp raw. The binary says which.
          if _shelp_line_is_task "$rest"; then
            _shelp_raw_dispatch suggest "$raw" "$rest"
          else
            zle accept-line
          fi ;;
      esac
      ;;
    (*)
      zle accept-line
      ;;
  esac
}
zle -N shelp-accept-line
# Bind on top of accept-line for every keymap shelp might be used from;
# non-shelp lines fall through to `zle accept-line`, so a wrapped
# accept-line from another plugin (zsh-autosuggestions,
# zsh-syntax-highlighting, powerlevel10k, ...) keeps working -- load this
# after such plugins for best results.
bindkey -M emacs '^M' shelp-accept-line
bindkey -M emacs '^J' shelp-accept-line
bindkey -M viins '^M' shelp-accept-line
bindkey -M viins '^J' shelp-accept-line
bindkey -M vicmd '^M' shelp-accept-line
bindkey -M vicmd '^J' shelp-accept-line
{{end}}

