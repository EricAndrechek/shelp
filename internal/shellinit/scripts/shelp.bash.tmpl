# shelp shell integration for bash. Load with:  eval "$(shelp init bash)"
# SHELP_HOOKS lists the shells whose integration is loaded, so
# `shelp setup shell` can tell the hook is already active.
export SHELP_HOOKS="bash${SHELP_HOOKS:+ $SHELP_HOOKS}"
# `shelp <task>` shows an editable "run>" prompt prefilled with the
# suggested command: Enter runs it, Ctrl-C abandons. It is also pushed to
# history so up-arrow recalls it. Non-interactive: just prints the command.
# Commands (`shelp providers`, `shelp help config`, ...) pass straight
# through.
#
# The wrapper calls no other function of this hook: some environments keep
# only some functions (Claude Code's shell snapshot drops every one whose
# name starts with `_`), so the command-or-task question is asked inline,
# the way _shelp_is_task below asks it. The binary decides (`shelp
# __kind`), not a list here: a shell keeps this hook until it restarts, so
# a list would miss commands added by an upgrade since and send `shelp
# <new command>` to the model. SHELP_PROVIDER names no provider so a shelp
# too old to know __kind fails at once instead of asking a model about
# "__kind ..."; any answer but "task" runs the arguments as typed.
shelp() {
  case "${1-}" in
    '')
      SHELP_SHELL=bash command shelp "$@"
      return ;;
    explain|-e)
      # On a terminal, a blank line after the explanation so it doesn't
      # run into the next prompt (as zsh and fish's raw line mode do).
      # Piped or redirected output stays byte-for-byte.
      local rc=0
      SHELP_SHELL=bash command shelp "$@" || rc=$?
      [ -t 1 ] && echo
      return $rc ;;
    suggest)
      # Reached by raw line mode below, which rewrites the typed line to
      # `shelp suggest -- <task>`: same editable "run>" flow as the
      # classic `shelp <task>` (unquoted) path, just with "suggest"
      # already consumed.
      shift ;;
    *)
      if [ "$(SHELP_PROVIDER=__kind command shelp __kind "$@" 2>/dev/null)" != task ]; then
        SHELP_SHELL=bash command shelp "$@"
        return
      fi ;;
  esac
  local cmd
  cmd=$(SHELP_SHELL=bash command shelp suggest "$@") || return
  [ -n "$cmd" ] || return 1
  if [ -t 0 ]; then
    history -s "$cmd" 2>/dev/null
    if read -r -e -p "run> " -i "$cmd" cmd && [ -n "$cmd" ]; then
      history -s "$cmd" 2>/dev/null
      eval "$cmd"
    fi
  else
    printf '%s\n' "$cmd"
  fi
}

# _shelp_is_task ARGS...: the same question, for raw line mode below: true
# when `shelp ARGS` is a task to suggest a command for, false when the
# binary runs it as one of its commands.
_shelp_is_task() {
  [ "$(SHELP_PROVIDER=__kind command shelp __kind "$@" 2>/dev/null)" = task ]
}

# Widget: turn the text on the command line into a command in place.
{{if .Bind}}# Bound to '{{.Bind}}' below.{{else}}# Bind it yourself, e.g.:  bind -x '"\C-g": shelp-widget'{{end}}
#
# While shelp runs, a dim `shelp: thinking…` (plain under NO_COLOR) stands
# where the line was: `bind -x` clears the line, prompt included, before
# running this and leaves the cursor at the start of that row, and
# readline redraws the prompt and line there afterwards -- so the status is
# erased (`\r\e[K`) before returning, on every path. Ctrl-C needs a trap
# for that: without one bash abandons this function and the line, leaving
# the status on screen. With it shelp still gets the SIGINT (and stops),
# the status is erased, and the typed line comes back, as in zsh and fish.
# (The raw-line path below needs none of this: it runs shelp as a command,
# after readline is done, with stderr on the terminal, so shelp's own
# spinner shows and clears itself.)
shelp-widget() {
  [ -n "$READLINE_LINE" ] || return
  local cmd rc=0 shown= saved_int
  if [ -t 2 ] && [ "${TERM-}" != dumb ]; then
    if [ -n "${NO_COLOR-}" ]; then
      printf 'shelp: thinking…' >&2
    else
      printf '\e[2;90mshelp: thinking…\e[0m' >&2
    fi
    shown=1
  fi
  saved_int=$(trap -p INT)
  trap : INT
  cmd=$(SHELP_SHELL=bash command shelp suggest -- "$READLINE_LINE" 2>/dev/null) || rc=$?
  if [ -n "$saved_int" ]; then eval "$saved_int"; else trap - INT; fi
  [ -n "$shown" ] && printf '\r\e[K' >&2
  [ "$rc" -eq 0 ] && [ -n "$cmd" ] || return 0
  READLINE_LINE=$cmd
  READLINE_POINT=${#cmd}
}

# `bind` warns ("line editing not enabled") and is a no-op in a
# non-interactive shell, so every binding below is guarded.
case $- in
  *i*)
{{if .Bind}}    bind -x '"{{.Bind}}": shelp-widget'
{{end}}{{if .LineMode}}
    # Raw line mode: pressing Enter or Ctrl-J on a line whose first word
    # is `shelp` rewrites the line to `shelp suggest -- <task>` / `shelp
    # explain -- <cmd>`, quoting the rest with `printf %q` so it reaches
    # shelp byte-for-byte -- no word-splitting, glob expansion, or quote
    # trouble. `shelp providers`, `shelp -p ... task`, and every other
    # subcommand/flag form still runs normally. Opt out with `shelp init
    # bash --no-line-mode` or config `[shell] line_mode = false`.
    #
    # `bind -x` can edit the line but can't submit it, so this uses an
    # unused key sequence, \C-x\C-_, to run the rewrite (__shelp_preaccept
    # below) and a private alias, \C-x\C-], bound directly to the real
    # `accept-line` readline function, to submit it; \C-m (Enter) and
    # \C-j are bound to a macro that replays both in order. bash's own
    # history never records the line that's actually submitted this way
    # (only an explicit `history -s` does), so __shelp_preaccept pushes
    # the line as typed before rewriting READLINE_LINE.

    # _shelp_line_is_task REST: _shelp_is_task on the words of REST, the
    # line after `shelp`, split on whitespace only (no quote removal, no
    # expansion: a quoted or globbed word is never a command) and cut
    # where the shell would end shelp's arguments, at the first operator
    # or redirection -- `shelp help config | less` asks about `help config`.
    _shelp_line_is_task() {
      local w op='^[0-9]*[<>|&;()]'
      local -a words=() args=()
      IFS=$' \t\n' read -r -d '' -a words <<<"$1" || :
      for w in "${words[@]}"; do
        [[ $w =~ $op ]] && break
        args+=("$w")
      done
      _shelp_is_task "${args[@]}"
    }

    __shelp_preaccept() {
      local line=$READLINE_LINE
      case $line in
        shelp[[:space:]]*) ;;
        *) return 0 ;;
      esac
      local rest=${line#shelp}
      rest=${rest#"${rest%%[^[:space:]]*}"}
      local word1=${rest%%[[:space:]]*}
      case $word1 in
        explain | -e)
          local tail=${rest#"$word1"}
          tail=${tail#"${tail%%[^[:space:]]*}"}
          [ -n "$tail" ] || return 0
          history -s -- "$line" 2>/dev/null
          READLINE_LINE="shelp explain -- $(printf '%q' "$tail")"
          READLINE_POINT=${#READLINE_LINE}
          ;;
        '' | -*)
          # Nothing after `shelp`, or flags first (`shelp -p fm <task>`):
          # only the shell can parse those, so the line runs as typed.
          return 0 ;;
        *)
          # A command (`shelp providers`, `shelp help config`) runs as
          # typed; a task goes to shelp raw. The binary says which.
          _shelp_line_is_task "$rest" || return 0
          history -s -- "$line" 2>/dev/null
          READLINE_LINE="shelp suggest -- $(printf '%q' "$rest")"
          READLINE_POINT=${#READLINE_LINE}
          ;;
      esac
    }
    bind -x '"\C-x\C-_": __shelp_preaccept'
    bind '"\C-x\C-]": accept-line'
    bind '"\C-m": "\C-x\C-_\C-x\C-]"'
    bind '"\C-j": "\C-x\C-_\C-x\C-]"'
{{end}}    ;;
esac

