# shelp shell integration for fish. Load with:  shelp init fish | source
# SHELP_HOOKS lists the shells whose integration is loaded, so
# `shelp setup shell` can tell the hook is already active.
set -gx SHELP_HOOKS fish $SHELP_HOOKS
# _shelp_is_task ARGS...: true when `shelp ARGS` is a task to suggest a
# command for, false when the binary runs it as one of its commands. The
# binary decides (`shelp __kind`, the decision it makes itself when it
# runs ARGS), not a list here: a shell keeps this hook until it restarts,
# so a list would miss commands added by an upgrade since and send
# `shelp <new command>` to the model. SHELP_PROVIDER names no provider so
# a shelp too old to know __kind fails at once instead of asking a model
# about "__kind ..."; any answer but "task" runs ARGS as typed.
function _shelp_is_task
    set -l kind (SHELP_PROVIDER=__kind command shelp __kind $argv 2>/dev/null)
    test "$kind" = task
end

# fish cannot pre-fill the next prompt from a function, so `shelp <task>`
# prints the command; the widget replaces the command line in place.
# Commands (`shelp providers`, `shelp help config`, ...) pass straight
# through.
function shelp
    if test -n "$argv[1]"; and _shelp_is_task $argv
        SHELP_SHELL=fish command shelp suggest $argv
    else
        SHELP_SHELL=fish command shelp $argv
    end
end

# Widget: turn the text on the command line into a command in place.
{{if .Bind}}# Bound to '{{.Bind}}' below.{{else}}# Bind it yourself, e.g.:  bind \cg shelp-widget{{end}}
function shelp-widget
    set -l line (commandline)
    test -n "$line"; or return
    set -l cmd (SHELP_SHELL=fish command shelp suggest -- "$line" 2>/dev/null | string collect)
    test -n "$cmd"; and commandline -r -- $cmd
    commandline -f repaint
end
{{if .Bind}}
bind {{.Bind}} shelp-widget
bind -M insert {{.Bind}} shelp-widget
{{end}}
{{if .LineMode}}
# Raw line mode: pressing Enter on a line whose first word is `shelp`
# sends the REST OF THE LINE to shelp byte-for-byte -- no shell parsing,
# so apostrophes, spaces, `$vars` and globs all reach the model exactly as
# typed. `shelp providers`, `shelp -p ... task`, and every other
# subcommand/flag form still runs normally. Opt out with `shelp init fish
# --no-line-mode` or config `[shell] line_mode = false`.

# _shelp_line_is_task REST: _shelp_is_task on the words of REST, the line
# after `shelp`, split on whitespace only (no quote removal, no expansion:
# a quoted or globbed word is never a command) and cut where the shell
# would end shelp's arguments, at the first operator or redirection --
# `shelp help config | less` asks about `help config`.
function _shelp_line_is_task
    set -l args
    for w in (string match -ar '\S+' -- $argv)
        string match -qr '^[0-9]*[<>|&;()]' -- $w; and break
        set -a args $w
    end
    _shelp_is_task $args
end

function _shelp_history_add
    # fish has no `history add`: search/delete/merge/save/clear are the
    # only sub-commands. The documented way to inject an entry without
    # running it is to append to fish's own history file in its (simple
    # YAML) format and `history merge` it into the live session -- see
    # MERGE NOTES for how this was verified against fish 3.6/3.7.
    set -l line $argv[1]
    set -l dir (set -q XDG_DATA_HOME[1]; and echo $XDG_DATA_HOME/fish; or echo $HOME/.local/share/fish)
    command mkdir -p $dir 2>/dev/null
    set -l esc (string replace -a '\\' '\\\\' -- $line)
    printf '%s\n' "- cmd: $esc" "  when: "(command date +%s) >>$dir/fish_history 2>/dev/null
    builtin history merge
end

# Call after printing below the prompt, before `commandline -f repaint`.
# The repaint doesn't know about the output: it starts the prompt as many
# lines above the cursor as the prompt has extra lines, so a multi-line
# prompt would be drawn over the last of that output. Give it those lines
# first, as fish's own __fish_list_current_token does.
function _shelp_prompt_room
    set -l extra (math (count (fish_prompt)) - 1)
    test $extra -gt 0; and string repeat -N \n --count=$extra
end

function _shelp_raw_dispatch
    # $argv[1]: mode (suggest|explain); $argv[2]: original typed line (for
    # history); $argv[3]: raw payload, byte-for-byte.
    set -l kind $argv[1]
    set -l orig $argv[2]
    set -l body $argv[3]

    if test "$kind" = explain
        echo
        command shelp explain --shell fish -- $body
        set -l rc $status
        echo
        _shelp_prompt_room
        if test $rc -eq 0
            _shelp_history_add $orig
            commandline -r -- ''
        else
            commandline -r -- $orig
        end
        commandline -f repaint
        return
    end

    # dim gray status (plain text when NO_COLOR is set), cleared below
    if test -n "$NO_COLOR"
        printf 'shelp: thinking…' >&2
    else
        printf '\e[2;90mshelp: thinking…\e[0m' >&2
    end
    set -l errfile (mktemp 2>/dev/null; or echo /tmp/shelp-fish-err.$fish_pid)
    # Ctrl-C reaches shelp, which stops. Unless a SIGINT handler exists,
    # fish also cancels this function on the spot, leaving the status on
    # screen and the line redrawn at the wrong column; with one, it
    # carries on: status cleared, the typed line back, no error shown.
    set -g _shelp_interrupted 0
    function _shelp_on_sigint --on-signal SIGINT
        set -g _shelp_interrupted 1
    end
    set -l cmd (command shelp suggest --shell fish -- $body 2>$errfile)
    set -l rc $status
    functions -e _shelp_on_sigint
    set -l intr $_shelp_interrupted
    set -e _shelp_interrupted
    printf '\r\e[K' >&2
    if test $rc -eq 0 -a -n "$cmd" -a $intr -eq 0
        _shelp_history_add $orig
        commandline -r -- $cmd
    else
        commandline -r -- $orig
        if test $intr -eq 0 -a -s $errfile
            # exactly one trailing newline, then room for the prompt
            printf '%s\n' (string collect <$errfile) >&2
            _shelp_prompt_room
        end
    end
    command rm -f $errfile
    commandline -f repaint
end

function _shelp_on_enter
    set -l line (commandline)
    if not string match -rq '^shelp\s' -- $line
        commandline -f execute
        return
    end
    set -l rest (string replace -r '^shelp\s+' '' -- $line)
    set -l word1 (string replace -r '^(\S*).*' '$1' -- $rest)
    switch $word1
        case explain -e
            set -l tail (string replace -r '^'"$word1"'\s+' '' -- $rest)
            if test -z "$tail"
                commandline -f execute
            else
                _shelp_raw_dispatch explain "$line" "$tail"
            end
        case '' '-*'
            # Nothing after `shelp`, or flags first (`shelp -p fm <task>`):
            # only the shell can parse those, so the line runs as typed.
            commandline -f execute
        case '*'
            # A command (`shelp providers`, `shelp help config`) runs as
            # typed; a task goes to shelp raw. The binary says which.
            if _shelp_line_is_task $rest
                _shelp_raw_dispatch suggest "$line" "$rest"
            else
                commandline -f execute
            end
    end
end
bind \r _shelp_on_enter
bind \n _shelp_on_enter
bind -M insert \r _shelp_on_enter
bind -M insert \n _shelp_on_enter
{{end}}

